{
  "name": "digital-printing",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/prepare-images.mjs && next dev",
    "build": "node scripts/prepare-images.mjs && next build && node scripts/finalize-export.mjs",
    "preview": "node scripts/preview.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:export": "node scripts/check-export.mjs",
    "check:browser": "node scripts/browser-check.mjs",
    "deploy:cloudflare": "npm run build && npx wrangler@4.151.0 pages deploy out --project-name digital-printing --branch main"
  },
  "dependencies": {
    "lucide-react": "1.57.0",
    "motion": "^12.0.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.4.0",
    "prettier": "^3.0.0",
    "sharp": "^0.34.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
